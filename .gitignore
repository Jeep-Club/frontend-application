# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/tests/docs/
/coverage
/storybook-static/
/playwright-report/
/test-results/

# next.js
/.next/
/.next-playwright/
/.next-playwright-*/
/build-e2e.log
/playwright-install.log
/playwright-discovery.log
/profile-smoke.log
/user-actions-smoke.log
/test-results-profile-smoke/
/test-results-user-actions-smoke/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright local reports
/test-results/
/playwright-report/

# Storybook
debug-storybook.log*

# Artefatos locais de testes e diagnóstico
/test-artifacts/
/*.log
/test-results-*/
